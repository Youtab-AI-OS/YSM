# Normalise line endings so a Windows checkout and a Linux CI run agree.
* text=auto eol=lf

# Windows-specific files that must keep CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary assets.
*.png   binary
*.jpg   binary
*.ico   binary
*.exe   binary
*.dll   binary
*.node  binary

# Inno Setup scripts are text.
*.iss   text
